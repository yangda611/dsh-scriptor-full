{
  "name": "@yangda611/dsh-scriptor-full",
  "version": "8.4.0",
  "description": "网文写作工作台完整版（含可选嵌入提供方）",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "webnovel",
    "writing",
    "chinese-novel",
    "ai-writing",
    "full-package"
  ],
  "homepage": "https://yangda611.github.io/dsh-scriptor-full/",
  "repository": {
    "type": "git",
    "url": "https://github.com/yangda611/dsh-scriptor-full.git",
    "directory": "packages/meta"
  },
  "bugs": {
    "url": "https://github.com/yangda611/dsh-scriptor-full/issues"
  },
  "license": "GPL-3.0-only",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/writing.patch.yml"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "RELEASE_NOTES.md",
    "LICENSE",
    "presets/*.yml"
  ],
  "dependencies": {
    "@yangda611/dsh-scriptor": "workspace:*",
    "@yangda611/dsh-scriptor-retrieval": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0",
    "node": ">=24.9.0"
  }
}
